[sub_resource type="GDScript" id="GDScript_bhunq"]
script/source = "extends RichTextLabel

@onready var dipth: RichTextLabel = $\".\"




# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	dipth.text = str(int(GlobalData.player_depth / 30)) + \"m\"
"

[sub_resource type="GDScript" id="GDScript_x4jx1"]
script/source = "extends ColorRect

@onready var running_out_of_air: ColorRect = $\".\"
var low_air_threshold : float = 10.0


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	if  GlobalData.current_air < 10:
		running_out_of_air.color.a = 1 - (0.2+(GlobalData.current_air / low_air_threshold))
	else:
		running_out_of_air.color.a = 0
"

